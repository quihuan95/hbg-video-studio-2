{
  "name": "hbg-shorts-studio",
  "version": "0.1.1",
  "private": true,
  "author": "The HBG Official",
  "description": "The HBG desktop video planning studio",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5174 && node scripts/run-electron.cjs\"",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc --noEmit && vite build && npm run build:electron",
    "start": "node scripts/run-electron.cjs --production",
    "package": "npm run build && electron-builder --win portable",
    "test": "tsc -p tsconfig.test.json && node --test .local/test-build/tests/*.test.js",
    "test:smoke": "npm run build && node scripts/smoke.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/win32-x64": "^4.1.0",
    "@ffprobe-installer/win32-x64": "^5.1.0",
    "@google/genai": "^3.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0",
    "prettier": "^3.10.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "wait-on": "^8.0.0"
  },
  "overrides": {
    "minimatch@^10.2.5": "^11.0.1"
  },
  "build": {
    "compression": "store",
    "appId": "vn.thehbg.shorts-studio",
    "productName": "HBG Shorts Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@ffmpeg-installer/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "win": {
      "target": "portable",
      "signAndEditExecutable": false
    }
  }
}
